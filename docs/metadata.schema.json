{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FDE Field Notes Metadata",
  "description": "Schema for metadata.json describing site and article metadata",
  "type": "object",
  "required": ["site", "articles"],
  "properties": {
    "site": {
      "type": "object",
      "required": ["base_url", "title", "description"],
      "properties": {
        "base_url": {
          "type": "string",
          "description": "Base URL for the site",
          "pattern": "^https?://"
        },
        "title": {
          "type": "string",
          "description": "Site title"
        },
        "description": {
          "type": "string",
          "description": "Site description"
        }
      }
    },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "slug", "title", "hook", "path", "date", "status", "format", "pillar", "tags", "reading_time_minutes", "pinned", "research_window"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique ID in YYYYMMDD-slug format",
            "pattern": "^\\d{8}-[a-z0-9-]+$"
          },
          "slug": {
            "type": "string",
            "description": "URL-safe slug",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "description": "Article title (2-6 words, punchy)"
          },
          "hook": {
            "type": "string",
            "description": "One or two sentence summary, ≤ 200 chars",
            "maxLength": 200
          },
          "path": {
            "type": "string",
            "description": "Path to article file",
            "pattern": "^articles/[a-z0-9-]+\\.html$"
          },
          "date": {
            "type": "string",
            "description": "Publish date in YYYY-MM-DD format",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "status": {
            "type": "string",
            "description": "Publication status",
            "enum": ["published", "draft", "archived"]
          },
          "format": {
            "type": "string",
            "description": "Article format",
            "enum": ["field-note", "analysis", "case-study", "interview"]
          },
          "pillar": {
            "type": "string",
            "description": "Content pillar",
            "enum": ["deployment-practice", "customer-judgment", "discovery-scoping", "internal-advocacy", "market-comp", "role-craft"]
          },
          "tags": {
            "type": "array",
            "description": "Article tags",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "reading_time_minutes": {
            "type": "number",
            "description": "Estimated reading time",
            "minimum": 1,
            "maximum": 30
          },
          "pinned": {
            "type": "boolean",
            "description": "Whether this is a pinned article"
          },
          "research_window": {
            "type": "string",
            "description": "Research date range (YYYY-MM-DD to YYYY-MM-DD)",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} to \\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  }
}
